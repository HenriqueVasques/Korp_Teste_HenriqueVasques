    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>861f0bcb-de4a-4596-808a-e1e811bfb613</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.2.0" />
